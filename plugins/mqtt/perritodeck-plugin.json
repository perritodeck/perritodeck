{
  "id": "dev.perritodeck.mqtt",
  "name": "MQTT",
  "version": "1.0.0",
  "description": "Publish an MQTT message when a key is pressed (Mosquitto, Zigbee2MQTT, Tasmota, Home Assistant).",
  "author": "PerritoDeck contributors",
  "runtime": "python",
  "main": "plugin.py",
  "actions": [
    {
      "id": "publish",
      "name": "Publish a message",
      "fields": [
        { "id": "broker", "label": "Broker", "type": "text", "placeholder": "192.168.1.10:1883" },
        { "id": "topic", "label": "Topic", "type": "text", "placeholder": "cmnd/desk-lamp/POWER" },
        { "id": "payload", "label": "Message", "type": "text", "placeholder": "TOGGLE" },
        { "id": "retain", "label": "Keep it on the broker (retain)", "type": "checkbox" },
        { "id": "username", "label": "User name (optional)", "type": "text" },
        { "id": "password", "label": "Password (optional)", "type": "text" }
      ]
    }
  ]
}
