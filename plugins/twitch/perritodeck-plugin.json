{
  "id": "dev.perritodeck.twitch",
  "name": "Twitch",
  "version": "1.1.4",
  "description": "Run your Twitch stream: markers, ads, clips, chat, title and category, moderation, raids, channel points, polls and predictions; show live status, viewers, followers, subs, the latest events and more.",
  "author": "PerritoDeck contributors",
  "runtime": "python",
  "main": "plugin.py",
  "settings": [
    {
      "id": "client_id",
      "label": "Client ID of your Twitch app (from dev.twitch.tv/console, client type Public)",
      "type": "text",
      "placeholder": "wbmytr93xzw8zbg0p1izqyzzc5mbiz"
    },
    {
      "id": "group_ads",
      "label": "Ads: run and snooze ads, ad schedule (sign in again after changing these)",
      "type": "checkbox",
      "default": true
    },
    {
      "id": "group_moderation",
      "label": "Moderation: chat modes, bans, raids, shoutouts, announcements, VIPs and mods",
      "type": "checkbox",
      "default": true
    },
    {
      "id": "group_points",
      "label": "Channel points: rewards and redemptions",
      "type": "checkbox",
      "default": true
    },
    {
      "id": "group_polls",
      "label": "Polls and predictions",
      "type": "checkbox",
      "default": true
    },
    {
      "id": "group_events",
      "label": "Events and totals: followers, subs, cheers, hype trains, redemptions",
      "type": "checkbox",
      "default": true
    },
    {
      "id": "preset_1",
      "label": "Preset 1: title | category | tags",
      "type": "text",
      "placeholder": "Speedrunning all evening! | Super Mario 64 | Speedrun, English"
    },
    {
      "id": "preset_2",
      "label": "Preset 2: title | category | tags",
      "type": "text",
      "placeholder": "Chill chat and coffee | Just Chatting | Cozy"
    },
    {
      "id": "preset_3",
      "label": "Preset 3: title | category | tags",
      "type": "text",
      "placeholder": "Building a base | Minecraft"
    },
    {
      "id": "preset_4",
      "label": "Preset 4: title | category | tags",
      "type": "text",
      "placeholder": "Title | Category | tag1, tag2"
    },
    {
      "id": "preset_5",
      "label": "Preset 5: title | category | tags",
      "type": "text",
      "placeholder": "Title | Category | tag1, tag2"
    }
  ],
  "actions": [
    {
      "id": "sign-in",
      "name": "Sign in to Twitch",
      "description": "Shows a code and opens twitch.tv/activate in your web browser; enter the code there. Do this after filling in the client ID, and again after changing which features are on."
    },
    {
      "id": "sign-out",
      "name": "Sign out of Twitch",
      "description": "Ends the sign-in at Twitch and forgets it on this computer."
    },
    {
      "id": "marker",
      "name": "Add a stream marker",
      "description": "Marks this moment of your live stream, to find it later in the video.",
      "fields": [
        {
          "id": "description",
          "label": "Note (optional)",
          "type": "text",
          "placeholder": "Great play"
        }
      ]
    },
    {
      "id": "clip",
      "name": "Make a clip",
      "description": "Clips the last moments of a live stream.",
      "fields": [
        {
          "id": "channel",
          "label": "Channel (empty for yours)",
          "type": "text",
          "placeholder": "yourchannel"
        },
        {
          "id": "open",
          "label": "Open the clip editor in the browser",
          "type": "checkbox",
          "default": false
        }
      ]
    },
    {
      "id": "open-last-clip",
      "name": "Open the last clip",
      "description": "Opens the last clip made from the deck in your web browser.",
      "fields": [
        {
          "id": "editor",
          "label": "Open the clip editor instead",
          "type": "checkbox",
          "default": false
        }
      ]
    },
    {
      "id": "set-info",
      "name": "Set the stream title or category",
      "description": "Leave a field empty to keep it as it is.",
      "fields": [
        {
          "id": "title",
          "label": "Title",
          "type": "text",
          "placeholder": "Speedrunning all evening!"
        },
        {
          "id": "category",
          "label": "Category (its exact name on Twitch)",
          "type": "text",
          "placeholder": "Just Chatting"
        }
      ]
    },
    {
      "id": "preset",
      "name": "Use a stream preset",
      "description": "Sets the title, category and tags saved as a preset on the Plugins page.",
      "fields": [
        {
          "id": "preset",
          "label": "Preset",
          "type": "select",
          "options": [
            {
              "value": "1",
              "label": "Preset 1"
            },
            {
              "value": "2",
              "label": "Preset 2"
            },
            {
              "value": "3",
              "label": "Preset 3"
            },
            {
              "value": "4",
              "label": "Preset 4"
            },
            {
              "value": "5",
              "label": "Preset 5"
            }
          ],
          "default": "1"
        }
      ]
    },
    {
      "id": "tags",
      "name": "Stream tags",
      "description": "Up to 10 tags, letters and digits only.",
      "fields": [
        {
          "id": "mode",
          "label": "Do",
          "type": "select",
          "options": [
            {
              "value": "set",
              "label": "Replace all tags"
            },
            {
              "value": "add",
              "label": "Add tags"
            },
            {
              "value": "remove",
              "label": "Remove tags"
            }
          ],
          "default": "set"
        },
        {
          "id": "tags",
          "label": "Tags, separated by commas",
          "type": "text",
          "placeholder": "Speedrun, English"
        }
      ]
    },
    {
      "id": "label",
      "name": "Content label",
      "description": "Turns a content classification label on or off for your stream.",
      "fields": [
        {
          "id": "label",
          "label": "Label",
          "type": "select",
          "options": [
            {
              "value": "politics",
              "label": "Politics and sensitive social issues"
            },
            {
              "value": "drugs",
              "label": "Drugs, intoxication or excessive tobacco use"
            },
            {
              "value": "gambling",
              "label": "Gambling"
            },
            {
              "value": "profanity",
              "label": "Significant profanity or vulgarity"
            },
            {
              "value": "sexual",
              "label": "Sexual themes"
            },
            {
              "value": "violence",
              "label": "Violent and graphic depictions"
            }
          ],
          "default": "politics"
        },
        {
          "id": "state",
          "label": "Turn",
          "type": "select",
          "options": [
            {
              "value": "toggle",
              "label": "On or off"
            },
            {
              "value": "on",
              "label": "On"
            },
            {
              "value": "off",
              "label": "Off"
            }
          ],
          "default": "toggle"
        }
      ]
    },
    {
      "id": "branded",
      "name": "Branded content",
      "description": "Marks your stream as branded content (sponsored) or not.",
      "fields": [
        {
          "id": "state",
          "label": "Turn",
          "type": "select",
          "options": [
            {
              "value": "toggle",
              "label": "On or off"
            },
            {
              "value": "on",
              "label": "On"
            },
            {
              "value": "off",
              "label": "Off"
            }
          ],
          "default": "toggle"
        }
      ]
    },
    {
      "id": "ad",
      "name": "Run an ad",
      "description": "Starts an ad break on your channel. Only for affiliates and partners, while live.",
      "fields": [
        {
          "id": "length",
          "label": "Length",
          "type": "select",
          "options": [
            {
              "value": "30",
              "label": "30 seconds"
            },
            {
              "value": "60",
              "label": "1 minute"
            },
            {
              "value": "90",
              "label": "1 minute 30"
            },
            {
              "value": "120",
              "label": "2 minutes"
            },
            {
              "value": "150",
              "label": "2 minutes 30"
            },
            {
              "value": "180",
              "label": "3 minutes"
            }
          ],
          "default": "30"
        }
      ]
    },
    {
      "id": "snooze-ad",
      "name": "Snooze the next ad",
      "description": "Pushes the next scheduled ad back 5 minutes, if you have snoozes left."
    },
    {
      "id": "chat",
      "name": "Send a chat message",
      "fields": [
        {
          "id": "message",
          "label": "Message",
          "type": "text",
          "placeholder": "Thanks for watching! Socials: perritodeck.dev"
        },
        {
          "id": "channel",
          "label": "Channel (empty for yours)",
          "type": "text",
          "placeholder": "yourchannel"
        }
      ]
    },
    {
      "id": "chat-saved",
      "name": "Send a saved chat message",
      "description": "Sends one of several messages: the next one each press, or one at random.",
      "fields": [
        {
          "id": "messages",
          "label": "Messages, separated by |",
          "type": "text",
          "placeholder": "Follow for more! | Join the Discord: perritodeck.dev | Hydrate!"
