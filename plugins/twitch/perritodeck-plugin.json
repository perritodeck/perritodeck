            {
              "value": "blue",
              "label": "Blue"
            },
            {
              "value": "green",
              "label": "Green"
            },
            {
              "value": "orange",
              "label": "Orange"
            },
            {
              "value": "purple",
              "label": "Purple"
            }
          ],
          "default": "primary"
        },
        {
          "id": "channel",
          "label": "Channel (empty for yours)",
          "type": "text",
          "placeholder": "yourchannel"
        }
      ]
    },
    {
      "id": "chat-mode",
