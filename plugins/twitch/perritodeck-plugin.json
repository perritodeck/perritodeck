        {
          "id": "channel",
          "label": "Channel (empty for yours)",
          "type": "text",
          "placeholder": "yourchannel"
        }
      ]
    },
    {
      "id": "chat-color",
      "name": "Chat name colour",
      "fields": [
        {
          "id": "color",
          "label": "Colour (blue, coral, hot_pink… or #RRGGBB with Turbo or Prime)",
          "type": "text",
          "placeholder": "blue_violet"
        }
      ]
    },
    {
      "id": "announce",
      "name": "Chat announcement",
