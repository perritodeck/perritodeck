{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PerritoDeck",
  "version": "0.1.0",
  "identifier": "dev.perritodeck.PerritoDeck",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PerritoDeck",
        "width": 1120,
        "height": 740,
        "minWidth": 720,
        "minHeight": 520,
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Use a tablet as a stream deck",
    "longDescription": "PerritoDeck turns an Android tablet into a grid of programmable buttons for your computer. This app runs the host in your tray: pair tablets, see your buttons, and keep them working while the window is closed.",
    "license": "Apache-2.0",
    "homepage": "https://perritodeck.dev",
    "publisher": "PerritoDeck",
    "copyright": "PerritoDeck contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../plugins/LICENSE": "plugins/LICENSE",
      "../../../plugins/audio/": "plugins/audio/",
      "../../../plugins/clipboard/": "plugins/clipboard/",
      "../../../plugins/clock/": "plugins/clock/",
      "../../../plugins/counter/": "plugins/counter/",
      "../../../plugins/gitlab/": "plugins/gitlab/",
      "../../../plugins/http/": "plugins/http/",
      "../../../plugins/hue/": "plugins/hue/",
      "../../../plugins/keylight/": "plugins/keylight/",
      "../../../plugins/media/": "plugins/media/",
      "../../../plugins/mqtt/": "plugins/mqtt/",
      "../../../plugins/obs/": "plugins/obs/",
      "../../../plugins/ollama/": "plugins/ollama/",
      "../../../plugins/proxmox/": "plugins/proxmox/",
      "../../../plugins/screenshot/": "plugins/screenshot/",
      "../../../plugins/soundboard/": "plugins/soundboard/",
      "../../../plugins/spotify/": "plugins/spotify/",
      "../../../plugins/sysmon/": "plugins/sysmon/",
      "../../../plugins/timer/": "plugins/timer/",
      "../../../plugins/truenas/": "plugins/truenas/",
      "../../../plugins/twitch/": "plugins/twitch/",
      "../../../plugins/uptime/": "plugins/uptime/",
      "../../../plugins/weather/": "plugins/weather/",
      "../../../plugins/windows/": "plugins/windows/",
      "../../../plugins/wol/": "plugins/wol/"
    },
    "createUpdaterArtifacts": false,
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "allowDowngrades": true,
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false,
        "compression": "lzma"
      },
      "wix": {
        "upgradeCode": "105995B0-7BA3-4946-AEE2-CD82FD788AB9",
        "language": "en-US"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "hardenedRuntime": true,
      "signingIdentity": "-",
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    },
    "linux": {
      "deb": {
        "section": "utils",
        "desktopTemplate": "linux/perritodeck.desktop",
        "depends": [],
        "recommends": []
      },
      "rpm": {
        "release": "1",
        "desktopTemplate": "linux/perritodeck.desktop",
        "depends": [],
        "recommends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
