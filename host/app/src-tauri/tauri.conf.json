{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PerritoDeck",
  "version": "0.1.0",
  "identifier": "dev.perritodeck.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PerritoDeck",
        "width": 1120,
        "height": 740,
        "minWidth": 720,
        "minHeight": 520,
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Use a tablet as a stream deck",
    "longDescription": "PerritoDeck turns an Android tablet into a grid of programmable buttons for your computer. This app runs the host in your tray: pair tablets, see your buttons, and keep them working while the window is closed.",
    "license": "Apache-2.0",
    "homepage": "https://perritodeck.dev",
    "publisher": "PerritoDeck",
    "copyright": "PerritoDeck contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
