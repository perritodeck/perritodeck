# Response headers for the site on Cloudflare (a Worker with static assets, which reads this
# file as Pages does; see docs/website.md, "Deploy"). Rules match the request path, and pages
# are served without ".html", so use /* rather than /*.html. A header set
# by two matching rules is joined with a comma, which for Content-Security-Policy means two
# policies that must both pass: keep the one CSP rule below.
#
# The CSP allows only files from this site. Pages have no inline scripts, styles or style=
# attributes (deck.js, download.js, catalogue.js and the .css files hold them instead), so
# keep it that way when editing a page or plugins/build_catalog.py's catalogue template.
# Nothing fetches at runtime, so connect-src stays at the default 'none'.
#
# no-transform keeps Cloudflare from rewriting pages at the edge: no Web Analytics beacon
# (the zone had automatic injection on without anyone turning it on, against the privacy page), no
# email obfuscation, no Rocket Loader. Keep it even with Web Analytics off in the dashboard.

/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Cache-Control: no-transform
  X-Robots-Tag: noindex
# ^ TEMPORARY: the X-Robots-Tag line keeps search engines out until the public launch.
#   Delete it on public launch day.

# Font files never change under the same name (rename one if it ever does).
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=86400

# The *.pages.dev address redirects to perritodeck.dev; keep it out of search results anyway.
https://:project.pages.dev/*
  X-Robots-Tag: noindex
